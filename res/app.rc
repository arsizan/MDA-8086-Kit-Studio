#include <windows.h>
#include "../src/resource.h"

IDI_APP ICON "app.ico"
1 RT_MANIFEST "app.manifest"

1 VERSIONINFO
FILEVERSION     1,1,0,0
PRODUCTVERSION  1,1,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Sizan"
            VALUE "FileDescription",  "MDA-8086 Kit Studio - assembler and loader for the MDA-8086 trainer kit"
            VALUE "FileVersion",      "1.1.0.0"
            VALUE "InternalName",     "KitStudio"
            VALUE "LegalCopyright",   "Free for students. Built-in assembler: JWasm (Sybase Open Watcom Public License 1.0)"
            VALUE "OriginalFilename", "KitStudio.exe"
            VALUE "ProductName",      "MDA-8086 Kit Studio"
            VALUE "ProductVersion",   "1.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
